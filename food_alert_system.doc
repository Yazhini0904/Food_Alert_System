<body><h1>Database food_alert_system</h1><h2>Table structure for table manufacturer</h2><table class="width100" cellspacing="1"><tr class="print-category"><th class="print">Field</th><td class="print"><b>Type</b></td><td class="print"><b>Null</b></td><td class="print"><b>Default</b></td></tr><tr class="print-category"><td class="print"><i><b>id</b></i></td><td class="print">int(11)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">name</td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">contact</td><td class="print">varchar(15)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print"><b>email</b></td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">address</td><td class="print">text</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">image</td><td class="print">varchar(255)</td><td class="print">Yes</td><td class="print">NULL</td></tr><tr class="print-category"><td class="print">password</td><td class="print">varchar(100)</td><td class="print">Yes</td><td class="print">NULL</td></tr></table><h2>Dumping data for table manufacturer</h2><table class="width100" cellspacing="1"><tr class="print-category"><td class="print">1</td><td class="print">sakthi</td><td class="print">9998887770</td><td class="print">sakthiextazee@gmail.com</td><td class="print">chennai</td><td class="print">1.jpg</td><td class="print">3115</td></tr></table><h2>Table structure for table orders</h2><table class="width100" cellspacing="1"><tr class="print-category"><th class="print">Field</th><td class="print"><b>Type</b></td><td class="print"><b>Null</b></td><td class="print"><b>Default</b></td></tr><tr class="print-category"><td class="print"><i><b>id</b></i></td>